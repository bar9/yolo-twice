{
  "name": "@yolo-twice/analyzers",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./graph": {
      "bun": "./src/graph.ts",
      "types": "./dist/graph.d.ts",
      "default": "./dist/graph.js"
    },
    "./search": {
      "bun": "./src/search.ts",
      "types": "./dist/search.d.ts",
      "default": "./dist/search.js"
    },
    "./structure": {
      "bun": "./src/structure.ts",
      "types": "./dist/structure.d.ts",
      "default": "./dist/structure.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@yolo-twice/core": "workspace:*",
    "minisearch": "^7.0.0"
  },
  "devDependencies": {
    "pele": "^1.13.0"
  }
}
